# =============================================================================
# STBcheck Configuration
# =============================================================================
# Copy this file to .env and modify values as needed.
# All values have sensible defaults - no .env file is required for development.
# =============================================================================

# =============================================================================
# Timeouts (in seconds)
# =============================================================================

# Timeout for HTTP requests to portals (default: 10)
REQUEST_TIMEOUT=10

# Timeout for streaming operations like proxy and concurrent checks (default: 60)
STREAM_TIMEOUT=60

# Timeout for fetching logo images (default: 15)
LOGO_FETCH_TIMEOUT=15

# =============================================================================
# Concurrency Limits
# =============================================================================

# Maximum number of concurrent portal checks - semaphore limit (default: 15)
MAX_CONCURRENT_PORTAL_CHECKS=15

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Maximum size of log file before rotation in bytes (default: 5242880 = 5MB)
LOG_FILE_MAX_BYTES=5242880

# Number of backup log files to keep (default: 2)
LOG_BACKUP_COUNT=2

# =============================================================================
# CORS Configuration
# =============================================================================

# Comma-separated list of allowed CORS origins
# Use '*' only for development!
CORS_ORIGINS=http://localhost:6767,http://127.0.0.1:6767

# =============================================================================
# Server Configuration
# =============================================================================

# Host address to bind the server to (default: 0.0.0.0)
SERVER_HOST=0.0.0.0

# Port number for the server (default: 6767)
SERVER_PORT=6767

# =============================================================================
# Application Settings
# =============================================================================

# Application version string
APP_VERSION=1.1.0

# Enable reduced timeouts for serverless deployment (default: False)
VERCEL_COMPATIBLE_MODE=False

# =============================================================================
# Security Settings
# =============================================================================

# Verify SSL certificates for outbound HTTP requests (default: True)
# Set to False only for testing with self-signed certs
VERIFY_SSL=True

# =============================================================================
# Date Parsing Configuration
# =============================================================================

# Timezone for parsing expiry dates from portal responses (default: UTC)
DATE_PARSING_TIMEZONE=UTC

# =============================================================================
# Stalker Detection Configuration
# =============================================================================

# Enable Stalker portal detection features (default: True)
STALKER_DETECTION_ENABLED=True

# =============================================================================
# Cache Configuration
# =============================================================================

# Maximum number of entries in the logo cache (default: 1000)
LOGO_CACHE_MAXSIZE=1000

# Time-to-live for logo cache entries in seconds (default: 300)
LOGO_CACHE_TTL=300

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# Rate limit for portal checking endpoint (e.g., '5/minute') (default: 5/minute)
RATE_LIMIT_PORTAL_CHECK=5/minute

# Rate limit for logo proxy endpoint (default: 2000/minute)
RATE_LIMIT_PROXY_LOGO=2000/minute

# Rate limit for streaming operations (default: 60/minute)
RATE_LIMIT_STREAM_OPS=60/minute

# =============================================================================
# Streaming Configuration
# =============================================================================

# Chunk size for streaming responses in bytes (default: 131072)
STREAM_CHUNK_SIZE=131072

# Chunk size for logo image transfers in bytes (default: 4096)
LOGO_CHUNK_SIZE=4096

# Maximum number of redirects to follow for URL validation (default: 10)
MAX_REDIRECTS=10
